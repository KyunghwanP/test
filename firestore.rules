rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appdata/{docId} {
      allow read, write: if request.auth != null
                        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                        && request.auth.token.email_verified == true;
    }
    match /weeklyData/{docId} {
      allow read, write: if request.auth != null
                        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                        && request.auth.token.email_verified == true;
    }
    // 교원 명렬 — 이름·부서·학반 등 '화면에 보이는 것'만 들어있다.
    // 연락처는 여기 없다(아래 contactsPhone 참고). 쓰기는 명렬 업로드뿐이라 관리자만.
    match /contacts/{docId} {
      allow read: if request.auth != null
                        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                        && request.auth.token.email_verified == true;
      allow write: if isAppAdmin();
    }
    // 학생 명렬 — 이름·학반·번호·동아리 등 '화면에 보이는 것'만 들어있다.
    // 연락처는 여기 없다(아래 studentsContact 참고). 쓰기는 명렬 업로드뿐이라 관리자만.
    match /students/{docId} {
      allow read: if request.auth != null
                        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                        && request.auth.token.email_verified == true;
      allow write: if isAppAdmin();
    }
    // ── 연락처 원본 ────────────────────────────────────────────────────
    // 교사 브라우저는 못 읽는다. teacher-api 워커가 서비스 계정으로만 읽어서
    // '한 번에 1명분'씩 내주고, 그 조회를 accessLogs 에 남긴다.
    //   왜: 예전에는 앱이 students/main · contacts/main 을 통째로 받아, 화면에는
    //   한 반만 보여주면서 전교생 연락처를 브라우저로 내려보내고 있었다. 개발자
    //   도구 없이 '페이지 저장' 한 번으로 전체가 유출되는 상태였다.
    // 쓰기는 명렬 업로드(upload.html)뿐이라 관리자만.
    //
    // 읽기가 관리자 한 명에게만 열려 있는 이유: upload.html 의 편성표 갱신이
    // 이 문서를 **덮어쓰기 전에 먼저 읽어야** 한다.
    //   · 저장 전 백업 — 되돌릴 수단이 이것뿐이다(Spark 요금제라 시점 복구가 없다)
    //   · 편성표에 빈 연락처가 기존 번호를 지우지 않게 대조
    //   · 반이 바뀐 학생을 이름+생년월일로 찾기(생년월일이 이 문서에 있다)
    // 같은 계정이 write 로 이미 통째로 갈아치울 수 있다. 읽기만 막으면 얻는 것 없이
    // '백업 없이 덮어쓰기' 만 남는다.
    // 교사 전체에는 절대 열지 말 것 — 그러면 위의 '페이지 저장 한 번' 으로 돌아간다.
    match /studentsContact/{docId} {
      allow read:  if isAppAdmin();
      allow write: if isAppAdmin();
    }
    // 위 studentsContact 와 같은 이유로 관리자에게만 읽기를 연다.
    // 비상연락망을 다시 올릴 때 이 문서를 덮어쓰기 전에 먼저 읽어야 한다.
    //   · 휴대폰 칸이 빈 사람은 기존 번호를 그대로 두기 — 안 읽으면 병합이 안 되고,
    //     내려받아 고친 파일(번호가 비어 있다)을 올리는 순간 전원의 번호가 날아간다
    //   · 저장 전 백업 — 되돌릴 수단이 이것뿐이다(Spark 요금제라 시점 복구가 없다)
    // 같은 계정이 write 로 이미 통째로 갈아치울 수 있다. 읽기만 막으면 얻는 것 없이
    // '백업 없이 덮어쓰기' 만 남는다.
    // 교사 전체에는 절대 열지 말 것 — 그러면 '페이지 저장 한 번' 으로 돌아간다.
    match /contactsPhone/{docId} {
      allow read:  if isAppAdmin();
      allow write: if isAppAdmin();
    }
    // ── 접속기록 (개인정보 보호법 제29조 안전조치 — 접속기록 보관·점검) ──
    // 워커(서비스 계정)만 쓴다. 교사가 자기 기록을 지우거나 고칠 수 없어야 한다.
    // 열람은 관리자만. 문서마다 expireAt 이 있어 Firestore TTL이 400일 뒤 지운다.
    match /accessLogs/{docId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }
    // ── 전체 새로고침 신호 ────────────────────────────────────────────
    // 배포해도 탭을 켜 둔 사람은 옛 화면을 계속 쓴다. 서비스워커의 '새 버전' 안내는
    // 화면을 새로 열 때만 뜨므로, 켜 둔 탭에는 영영 안 뜬다 — 새로고침해야
    // 새로고침하라는 안내가 뜨는 꼴이다. 그래서 관리자가 여기에 번호를 올리면
    // 열려 있는 화면들이 스냅샷으로 받아 새로고침한다.
    // appdata 에 두면 안 된다 — 거긴 전 교사가 쓸 수 있어서 아무나 전체
    // 새로고침을 걸 수 있게 된다.
    match /appNotice/{docId} {
      allow read:  if isYnhsTeacher();
      allow write: if isAppAdmin();
    }
    // ── 사용량 (누가 앱을 얼마나 쓰는지) ──────────────────────────────
    // 한 사람 한 달치를 문서 하나에 담는다. 자기 문서에만 쓸 수 있고(경로에 이메일이
    // 들어간다), 읽기는 관리자만. 남는 것은 연 횟수와 탭 이름·횟수뿐이다 —
    // 무엇을 검색했는지 같은 내용은 담지 않는다(연락처 조회는 위 accessLogs).
    match /usage/{email}/m/{ym} {
      allow read:  if isAppAdmin();
      allow write: if isYnhsTeacher() && request.auth.token.email == email;
    }
    // 교실 자리 배치 — 문서 ID 는 '학년-반'(예: 2-3).
    // 조회는 전 교사(수업 들어갈 때 이름을 봐야 한다), 저장은 그 반 담임과 관리자만.
    // 담임 판정은 학부모 상담이 쓰는 acl/gradeRoles.homerooms 를 그대로 재사용한다.
    match /seating/{classKey} {
      allow read:  if isYnhsTeacher();
      allow write: if isHomeroomOf(classKey) || isAppAdmin();
    }
    // 동아리 메타데이터 (지도교사·전공·교실·정원·학년) — 교사 읽기/쓰기
    match /clubs/{docId} {
      allow read, write: if request.auth != null
                        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                        && request.auth.token.email_verified == true;
    }
    match /schedule/{docId} {
      allow read: if request.auth != null
                 && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                 && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                 && request.auth.token.email_verified == true;
      allow write: if false;
    }
    match /riro_points/{docId} {
      allow read: if request.auth != null
                 && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
                 && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
                 && request.auth.token.email_verified == true;
      allow write: if false;
    }
    // ── 성적 열람 권한 문서 (sync-grades Actions가 매일 생성) ──
    // { managers: [이메일...], homerooms: { 이메일: '학년-반' } }
    // 교사 읽기 허용(앱이 탭 노출 판단에 사용). 쓰기는 서비스 계정만.
    // 쓰기는 동기화(서비스 계정, 규칙 미적용)와 관리자만.
    // 관리자 쓰기는 upload.html의 '교원 명렬 업로드'와 전체열람 명단 관리를 위한 것.
    // (교사 전체에 열면 누구나 자기를 전체열람 권한자로 넣을 수 있다)
    match /acl/{docId} {
      allow read: if isYnhsTeacher();
      allow write: if isAppAdmin();
    }
    // ── 모의고사 성적 (진로진학부 시트 → GitHub Actions 동기화) ──
    // 읽기: 전체열람 권한자(관리자·교장·교감·부장) 또는 자기 반 담임만.
    // 담임은 학생 트리(index)와 자기 반 문서만 읽을 수 있다.
    // 쓰기는 서비스 계정(Admin SDK, 규칙 미적용)의 동기화만 수행.
    match /gradesMock/{docId} {
      allow read: if canReadGrades(docId);
      allow write: if false;
    }
    // ── 졸업생 수시 합격 현황 (진로진학부 시트 → GitHub Actions 동기화) ──
    match /gradesSusi/{docId} {
      allow read: if isYnhsTeacher();
      allow write: if false;
    }
    // ── 수시·정시 입결 (진로진학부 시트 → GitHub Actions 동기화) ──
    match /gradesIpgyeol/{docId} {
      allow read: if isYnhsTeacher();
      allow write: if false;
    }
    // ── 학생 선택과목 (교육과정 현황 엑셀 → upload.html 교사 업로드) ──
    // 2026-08부터 구글시트 동기화 대신 교사가 앱에서 직접 업로드(SheetJS 파싱). 교사 읽기/쓰기.
    match /electives/{docId} {
      allow read, write: if isYnhsTeacher();
    }
    // 업무 캘린더
    match /tasks/{userId}/items/{itemId} {
      // 학교 교사면 읽기 가능 (공유 일정 구독)
      allow read: if isYnhsTeacher();
      // 소유자는 전체 쓰기 가능
      allow write: if isYnhsTeacher() && request.auth.uid == userId;
      // 공유받은 사람은 status / comments 필드만 수정 가능
      // (기존 문서가 있고, 본인이 sharedWith에 포함된 경우)
      allow update: if isYnhsTeacher()
                   && resource.data.sharedWith != null
                   && isSharedWithMe(resource.data.sharedWith)
                   && onlyStatusOrComments();
    }
    // (혹시 하위 경로를 더 쓰는 경우 대비) 그 외 tasks 문서는 소유자만
    match /tasks/{userId}/{document=**} {
      allow read: if isYnhsTeacher();
      allow write: if isYnhsTeacher() && request.auth.uid == userId;
    }
    // ── 학부모 상담 예약 ──
    // 학부모(비로그인)는 Firestore를 직접 접근하지 않는다. 조회·예약·취소는
    // 모두 Worker(서비스계정)가 처리하며, 서비스계정은 보안 규칙의 적용을 받지
    // 않으므로(관리자 권한) 학부모용 동작은 여기서 전부 차단해도 된다.
    //
    // 이 문서에는 예약자 이름·연락처·상담 사유(bookedMemo)가 들어 있다.
    // 상담 사유에는 가정 문제·교우 관계 같은 내용이 적히므로 담임 외에는 볼 이유가 없다.
    // → '학교 계정이면 전부'가 아니라 '그 반 담임 + 관리자'로 좁힌다.
    //   (앱은 원래 본인 반만 읽으므로 화면 동작은 달라지지 않는다.
    //    막히는 것은 콘솔 등으로 남의 반 문서를 직접 여는 경우뿐이다.)
    match /consultations/{classKey} {
      allow read, write: if isAppAdmin() || isHomeroomOf(classKey);
    }
    // ── 학부모 상담: 학부모에게 공개하는 미러 문서 ──
    // 원본(consultations)에는 예약자 이름·연락처·메모가 들어 있어 학부모가 직접
    // 읽으면 남의 개인정보가 보인다. 그래서 개인정보를 뺀 미러를 따로 두고,
    // 학부모 브라우저는 이 문서만 '직접' 읽는다(오픈 시각 폭주를 서버 없이 감당).
    //   내용: 열린 슬롯의 id·date·time·duration + openAt 뿐. 개인정보 없음.
    // 읽기: Worker가 발급한 커스텀 토큰의 classKey 클레임이 일치하는 학부모만
    //       자기 반 문서를. (교사도 학교 계정으로 읽을 수 있어야 미러 동기화 가능)
    // 쓰기: 교사 앱(슬롯 편집 시 원본과 함께 갱신). 워커는 서비스계정이라 규칙 미적용.
    match /consultationsPublic/{classKey} {
      allow read: if isYnhsTeacher()
                 || (request.auth != null && request.auth.token.classKey == classKey);
      allow write: if isYnhsTeacher();
    }
    // ── 특별실 사용 예약 ──
    // _config(특별실 목록)·{roomId}_{주} 예약 문서. 교사만 접근.
    // (취소 권한 등 세부 제어는 클라이언트에서 처리 — 상담 예약과 동일한 신뢰 모델)
    match /roomBookings/{docId} {
      allow read, write: if isYnhsTeacher();
    }
    // ── 개인 메모 (memo.html) — 본인 것만 읽기/쓰기 ──
    // 루트 문서(구버전 단일 메모) + pages 하위 컬렉션(노션식 페이지) 모두 포함
    match /memos/{userId}/{document=**} {
      allow read, write: if isYnhsTeacher() && request.auth.uid == userId;
    }
    // ── 개인 메모 실험판 (memo2.html) — 본인 것만. 기존 memos와 분리 ──
    match /memos2/{userId}/{document=**} {
      allow read, write: if isYnhsTeacher() && request.auth.uid == userId;
    }
    // ── 업무자료 엑셀 시트 데이터 (편성·명렬표 등) ──
    // 학생 개인정보 포함 — 퍼블릭 저장소(GitHub Pages)에 파일로 올릴 수 없어
    // 교사가 앱에서 직접 업로드(SheetJS 파싱)해 여기에 저장. 교사만 읽기/쓰기.
    match /docsSheets/{docId} {
      allow read, write: if isYnhsTeacher();
    }
    // ── 사진명렬 (학생 사진) — 반별 문서 {학년-반}.photos = { 번호: dataURL } ──
    // 학생 개인정보(얼굴) 포함 — 원본 xlsx는 저장소에 못 올려, 교사가 앱에서
    // 브라우저로 파싱·압축해 사진만 저장. 교사만 읽기/쓰기.
    match /studentPhotos/{docId} {
      allow read, write: if isYnhsTeacher();
    }
    // ── 외출증 (조퇴·외출·결과) — 종이 쪽지를 대체한다 ──
    // passes/{YYYY-MM-DD}/items/{자동ID}
    // 날짜별로 나눠 담는다. 상담 슬롯처럼 한 문서에 학기 내내 쌓이면 1MB 한계에
    // 부딪히고, 발급과 조회가 서로 다른 문서를 건드려 동시 작업 경합도 없다.
    //
    // 발급은 교사 누구나 할 수 있게 둔다. 담임만으로 막으면 '담임이 자리에 없어
    // 못 끊어주는' 문제가 그대로 남는데, 그게 이 기능을 만든 이유 중 하나다.
    // 대신 누가 끊었는지(issuedBy)를 반드시 남기고, 남의 이름으로 못 쓰게 막는다.
    match /passes/{day}/items/{passId} {
      allow read: if isYnhsTeacher();
      // 발급자를 자기 이메일로만 적을 수 있다(남의 이름으로 끊는 것 방지)
      allow create: if isYnhsTeacher()
                   && request.resource.data.issuedBy == request.auth.token.email;
      // 잘못 끊은 것을 고치거나 지우는 건 발급자 본인과 관리자만.
      // issuedBy 는 바꿀 수 없다 — 바꿀 수 있으면 발급자 기록이 의미가 없다.
      allow update: if (isAppAdmin() || resource.data.issuedBy == request.auth.token.email)
                   && request.resource.data.issuedBy == resource.data.issuedBy;
      allow delete: if isAppAdmin() || resource.data.issuedBy == request.auth.token.email;
    }
    // 날짜 문서 자체는 쓰지 않는다(서브컬렉션만 쓴다). 실수로 만들지 못하게 막아 둔다.
    match /passes/{day} {
      allow read: if isYnhsTeacher();
      allow write: if false;
    }
    // ── 공통 함수 ──
    function isYnhsTeacher() {
      return request.auth != null
        && request.auth.token.email.matches('.*@yeungnam[.]hs[.]kr$')
        && !request.auth.token.email.matches('^[0-9]{7}@yeungnam[.]hs[.]kr$')
        && request.auth.token.email_verified == true;
    }
    // 성적 열람 권한: acl/gradeRoles 문서 기준
    // (문서가 아직 없으면 get() 오류 → 전면 거부되므로, 규칙 적용 전에
    //  sync-grades Actions를 한 번 실행해 문서를 만들어 둘 것)
    function gradeAcl() {
      return get(/databases/$(database)/documents/acl/gradeRoles).data;
    }
    // 이 사람이 classKey 반의 담임인가 (학부모 상담 문서 접근 판정)
    //  · acl/gradeRoles.homerooms = { 이메일: '학년-반' } — 성적 권한이 쓰는 그 문서를 재사용
    //  · 문서가 없으면 get()이 규칙 전체를 거부하므로 exists()로 먼저 확인한다
    //  · 표기가 다를 수 있다: homerooms는 '2-3'으로 정규화해 저장하는데,
    //    상담 문서 ID는 시간표의 원본 표기(예 '2-03')를 그대로 쓴다.
    //    담임이 자기 반에서 막히는 일이 없도록 숫자로 비교한다.
    function isHomeroomOf(classKey) {
      return isYnhsTeacher()
        && exists(/databases/$(database)/documents/acl/gradeRoles)
        && request.auth.token.email in gradeAcl().homerooms
        && sameClass(gradeAcl().homerooms[request.auth.token.email], classKey);
    }
    function sameClass(a, b) {
      return a == b
        || (a.matches('^[0-9]+-[0-9]+$') && b.matches('^[0-9]+-[0-9]+$')
            && int(a.split('-')[0]) == int(b.split('-')[0])
            && int(a.split('-')[1]) == int(b.split('-')[1]));
    }
    // 관리자가 콘솔에서 직접 관리하는 전체열람 명단(acl/gradeManual).
    // Actions 동기화를 기다리지 않고 즉시 반영된다. 문서가 없어도 안전하도록
    // exists()로 먼저 확인한다(없는 문서를 get()하면 규칙 전체가 거부된다).
    // 앱 관리자(권한 명단·교원 명렬을 관리하는 계정)
    function isAppAdmin() {
      return isYnhsTeacher() && request.auth.token.email == 'pkh910518@yeungnam.hs.kr';
    }
    function isManualManager() {
      return exists(/databases/$(database)/documents/acl/gradeManual)
        && request.auth.token.email in
             get(/databases/$(database)/documents/acl/gradeManual).data.managers;
    }
    function canReadGrades(docId) {
      return isYnhsTeacher() && (
        isManualManager()
        || request.auth.token.email in gradeAcl().managers
        || (request.auth.token.email in gradeAcl().homerooms
            && (docId == 'index'
                || gradeAcl().homerooms[request.auth.token.email] == docId))
      );
    }
    // sharedWith 배열에 내 식별자(email 또는 displayName/name)가 있는지
    function isSharedWithMe(sharedWith) {
      return sharedWith.hasAny([request.auth.token.email, request.auth.token.name]);
    }
    // 이번 수정이 status / comments / sharedWith / doneBy 필드만 건드렸는지 검사
    // (sharedWith: 공유받은 사람이 '공유 나가기'로 본인 제거,
    //  doneBy: '각자 완료 방식' 일정에서 본인 완료 체크)
    function onlyStatusOrComments() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'comments', 'sharedWith', 'updatedAt', 'doneBy']);
    }
  }
}
